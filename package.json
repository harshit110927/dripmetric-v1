{
  "name": "dripmetric",
  "private": true,
  "version": "2.0.0",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build && pnpm -r --filter \"./examples/**\" build",
    "dev": "node scripts/dev.mjs",
    "db:up": "docker compose up -d postgres && node scripts/wait-for-db.mjs",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @dripmetric/db migrate",
    "db:reset": "pnpm --filter @dripmetric/db reset",
    "sim": "pnpm --filter @dripmetric/sim sim",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter dripmetric test:e2e",
    "check:names": "node scripts/check-script-names.mjs",
    "screens": "node scripts/screens.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "sdk:build": "pnpm --filter dripmetric build",
    "sdk:size": "pnpm --filter dripmetric size",
    "verify": "pnpm check:names && pnpm check:fixtures && pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:licenses && pnpm test",
    "ready": "pnpm format && pnpm verify",
    "shadow:up": "docker compose up -d postgres-shadow && node scripts/wait-for-db.mjs --shadow",
    "shadow:migrate": "pnpm --filter @dripmetric/db migrate:shadow",
    "shadow:reconcile": "pnpm --filter @dripmetric/worker reconcile",
    "load": "node scripts/load-test.mjs"
  },
  "devDependencies": {
    "@dripmetric/db": "workspace:*",
    "@dripmetric/ingest": "workspace:*",
    "@dripmetric/sim": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "eslint": "10.13.0",
    "globals": "^17.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
