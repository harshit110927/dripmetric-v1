# Generated by Next.js on every build.
# Generated by `next build` / `next dev`, and the two write DIFFERENT contents, so a
# tracked copy flips back and forth with whichever ran last. Next's own header says
# not to edit it.
apps/web/next-env.d.ts
examples/next-app/next-env.d.ts

