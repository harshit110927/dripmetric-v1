# Copy to .env for local development. .env is gitignored (CLAUDE.md rule 3).
# Everything here is a dev placeholder. Never put a production credential in this repo.

NODE_ENV=development

# --- Database -----------------------------------------------------------------
# Local Postgres from docker-compose.yml.
# In production this is Supabase: the web app uses the TRANSACTION pooler (port 6543,
# prepared statements off — we never name a query, so `pg` never prepares one) and the
# worker uses a DIRECT or SESSION connection, because pg-boss needs advisory locks,
# LISTEN/NOTIFY and long transactions. See brief section 12 "Supabase connections".
# The app connects as a NON-OWNER role, because row-level security does not apply to
# a table's owner. This is what makes RLS a real backstop and not decoration.
DATABASE_URL=postgres://dripmetric_app:dripmetric_app@localhost:54329/dripmetric
# Optional. Falls back to DATABASE_URL when unset.
WORKER_DATABASE_URL=
# Owner connection. Used ONLY by `pnpm db:migrate` and `pnpm db:reset`.
ADMIN_DATABASE_URL=postgres://dripmetric:dripmetric@localhost:54329/dripmetric

# --- App ----------------------------------------------------------------------
APP_URL=http://localhost:3000
# Used to sign founder login sessions and magic links. Dev value only.
# Generate a real one with: openssl rand -base64 48
AUTH_SECRET=dev-only-auth-secret-change-me-0000000000000000

# --- Encryption ---------------------------------------------------------------
# App-level envelope encryption (AES-256-GCM) for Slack/Discord webhook URLs,
# end-user emails and name-like traits. Settled decision D4.
# Format: <keyId>:<base64 32-byte key>, comma-separated. The FIRST key encrypts;
# all of them decrypt, so a key can be rotated without a backfill.
# Generate: openssl rand -base64 32
ENCRYPTION_KEYS=k1:ZGV2LW9ubHktMzItYnl0ZS1rZXktZm9yLWxvY2FsISE=

# --- Email (Resend) -----------------------------------------------------------
# Leave RESEND_API_KEY empty in dev: mail is written to the console mailbox instead
# (apps/web prints the magic link). Tests never call a paid API.
RESEND_API_KEY=
EMAIL_FROM="Dripmetric <hello@dripmetric.com>"

# --- AI (event-mapping suggestions, M5) ---------------------------------------
# Empty in dev and in tests; the Inbox works by hand without it.
ANTHROPIC_API_KEY=
# Verified 2026-10-28: Haiku 5.5 is the smallest model, $0.10/$0.50 per M tokens.
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Observability ------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# --- Production guard (M13) ---------------------------------------------------
# In production mode, live (non-test) projects cannot be created unless this is true.
# It is the founder's confirmation that backups exist. Settled decision 1.
BACKUPS_CONFIRMED=false

# ---------------------------------------------------------------------------
# The shadow copy (settled decision 1, M13).
#
# A second Postgres that the worker dual-writes to, so there is somewhere to
# restore from. Supabase Free has no backups, and the gate on real founder data is
# "the shadow copy OR Supabase Pro backups".
#
# Leave it unset and everything works with the shadow paths doing nothing, which is
# a supported state. The worker says so at startup rather than being quiet about it.
#
# Locally: `pnpm shadow:up && pnpm shadow:migrate`.
# ---------------------------------------------------------------------------
SHADOW_DATABASE_URL=

# ---------------------------------------------------------------------------
# Slack and Discord OAuth (M10).
#
# The base URLs default to the in-app mock at /dev/oauth/<kind>, so the install flow
# is testable with no accounts. Point them at the real endpoints in production and
# fill in the client ids and secrets.
# ---------------------------------------------------------------------------
SLACK_OAUTH_BASE=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_OAUTH_BASE=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# The gate (settled decision 1, M13).
#
# In production, creating a LIVE project is refused unless this is exactly "true".
# Setting it is a statement that backups exist; it does not create them.
# ---------------------------------------------------------------------------
BACKUPS_CONFIRMED=
