{
  "name": "@dripmetric/db",
  "version": "2.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "migrate": "tsx src/cli/migrate.ts",
    "reset": "tsx src/cli/migrate.ts --reset",
    "migrate:shadow": "tsx src/cli/migrate.ts --shadow"
  },
  "dependencies": {
    "@dripmetric/catalog": "workspace:*",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
